{
  "name": "cdk",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npm run build && node --require ts-node/register/transpile-only --test --test-concurrency=1 test/*.test.ts",
    "cdk": "cdk",
    "synth": "cdk synth",
    "security:audit": "npm audit --audit-level=high",
    "tags:check": "node scripts/check-required-tags.js"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "aws-cdk": "2.1148.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "^10.6.0"
  }
}
